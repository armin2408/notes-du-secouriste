    <string name="about_title">À propos</string>
    <string name="about_volunteer_title">Une application bénévole</string>
    <string name="about_volunteer_body">Notes du Secouriste est développée bénévolement, sur du temps libre, par un secouriste pour les secouristes.\n\nElle est gratuite et le restera. Aucun compte n’est nécessaire et aucune donnée n’est envoyée vers un serveur : tout reste sur votre téléphone.\n\nVos retours et idées d’amélioration sont précieux pour faire évoluer l’application.</string>
    <string name="about_coffee_title">Payer un café au développeur</string>
    <string name="about_coffee_body">Si l’application vous rend service, vous pourrez bientôt soutenir son développement en offrant un café. Totalement facultatif : l’application reste entièrement gratuite.</string>
    <string name="about_coffee_badge">À venir</string>
